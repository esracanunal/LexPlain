# Bu dosyayı .env olarak kopyalayın ve anahtarınızı girin. .env dosyası git'e GÖNDERİLMEZ.
# Anahtar yoksa uygulama temel inceleme (kural tabanı) modunda çalışır.

# --- Google Gemini (önerilen, ücretsiz kotası var) ---
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Ana model yoğun/hatalıysa sırayla denenecek modeller (virgülle ayırın)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# --- Anthropic Claude (isteğe bağlı) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# İki anahtar da varsa hangisi kullanılsın? gemini / anthropic (boş: Gemini)
AI_PROVIDER=

AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=1
# IPv6'nın sorunlu olduğu ağlarda takılmayı önler (1 = açık)
AI_FORCE_IPV4=1
MAX_UPLOAD_MB=8
MAX_TEXT_CHARS=60000
